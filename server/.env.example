# Server
HOST=127.0.0.1
PORT=3001
# DATA_DIR=./data
# INVENTORY_DIR=../inventory

# Layout model: openclaw | ollama | none
LLM_PROVIDER=openclaw
LLM_TIMEOUT_MS=180000
GENERATION_MAX_TURNS=12
GENERATION_TIME_BUDGET_MS=900000

# Dedicated OpenClaw gateway from scripts/setup-openclaw.sh
# (token is read from the config file when not set)
OPENCLAW_BASE_URL=http://127.0.0.1:18989
OPENCLAW_AGENT_ID=interior
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_CONFIG_PATH=~/.openclaw-interior/openclaw.json

# Direct Ollama fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6-35b-a3b-fp8:latest
OLLAMA_NUM_CTX=32768
