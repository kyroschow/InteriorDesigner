# Copy to .env.local and restart Vite after changing.

# mock (default): in-browser mock of /api/v1, persisted in localStorage.
# live: real HTTP requests to VITE_API_BASE_URL + /api/v1, no mock fallback.
VITE_API_MODE=mock

# Backend origin without /api/v1, e.g. http://localhost:8000. Blank = same origin.
VITE_API_BASE_URL=
