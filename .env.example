# Copy to .env.local (git-ignored) and restart Vite after changing.

# Where the Vite dev server forwards /api. Defaults to a local `npm run dev:server`.
API_PROXY_TARGET=http://127.0.0.1:3001

# Backend origin without /api/v1. Leave blank to use the dev proxy above:
# server/ sends no CORS headers, so a cross-origin URL only works once CORS is added there.
VITE_API_BASE_URL=
